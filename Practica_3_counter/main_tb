module main_tb (
);

    reg clk;
	reg rst;
	reg up_down;
	reg load;
	reg  [6:0] data_in;
	wire [0:6] D_un,D_de,D_ce,D_mi;


    main DUT(.clk(clk),
	 .rst (rst),
	 .up_down (up_down),
	 .load (load),
	 .data_in (data_in), .D_un(D_un),.D_de(D_de),.D_ce(D_ce),.D_mi(D_mi));

   initial begin
        clk= 0;
        rst = 0;
    forever 
    #10 clk =~clk;
    end

    initial begin
    
    $display("sim iniciada") ;  

    
    
    $display("sim finalizada"); 
    $stop;
    $finish;
    end
  


initial begin
    $monitor("up_down = %b ,load = %b ,data_in = %b,D_un= %b, D_de= %b, D_ce= %b, D_mi = %b, clk = %b", up_down,load,data_in,D_un, D_de, D_ce, D_mi,clk);
end

initial begin
    $dumpfile("main_tb.vcd");
    $dumpvars(0,main_tb);

end
	 

endmodule
