module BCD_5display #(parameter N_in = 10, N_out = 7)(
    input [N_in -1:0] bcd_in,
	 input [N_in -1:0] bcd_in_seg,
    output [N_out -1:0] D_un,D_de,D_ce,D_mi,D_mi_s
);

wire [4:0] unidades,decenas,centenas,segundos, segundos_c;

assign unidades = bcd_in % 10;
assign decenas = (bcd_in/10) % 10;
assign centenas = (bcd_in/100) % 10;
assign segundos = bcd_in_seg % 10;
assign segundos_c = (bcd_in_seg/10) % 10;

BCD unit(
    .BCD_in(unidades),
    .BCD_out(D_un)
);

BCD decens(
    .BCD_in(decenas),
    .BCD_out(D_de)
);

BCD centens(
    .BCD_in(centenas),
    .BCD_out(D_ce)
);

BCD milars(
    .BCD_in(segundos),
    .BCD_out(D_mi)
);

BCD milarses(
    .BCD_in(segundos_c),
    .BCD_out(D_mi_s)
);

endmodule
